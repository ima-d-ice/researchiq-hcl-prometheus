# One key, or many comma-separated to rotate on rate limits (each key gets its own 8k TPM)
GROQ_API_KEY_1=
GROQ_API_KEY_2=
# ... up to GROQ_API_KEY_12 (each key gets its own 8k TPM budget; rotated on 429)
# Verify the exact Groq model id for Qwen 3.8 27B
LLM_MODEL=qwen/qwen3.8-27b
QDRANT_PATH=data/qdrant
QDRANT_COLLECTION=papers
LLM_FALLBACK_MODEL=llama-3.3-70b-versatile
VLM_FALLBACK_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
# Groq free-tier budget (limiter keeps a 10% margin)
GROQ_TPM_LIMIT=8000
GROQ_RPM_LIMIT=30
GROQ_TPD_LIMIT=200000
